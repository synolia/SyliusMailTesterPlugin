{
    "name": "synolia/sylius-mail-tester-plugin",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "mail",
        "tester"
    ],
    "description": "Mail Tester Plugin.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "fakerphp/faker": "^1.10",
        "sylius/sylius": "^2.2",
        "symfony/service-contracts": "^3.5",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "friendsoftwig/twigcs": "6.6.1",
        "php-parallel-lint/php-parallel-lint": "1.4.0",
        "phpmd/phpmd": "3.0.0",
        "phpro/grumphp": "2.27.2",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.1.56",
        "phpstan/phpstan-doctrine": "2.0.12",
        "phpstan/phpstan-phpunit": "2.0.4",
        "phpstan/phpstan-strict-rules": "2.0.3",
        "phpstan/phpstan-webmozart-assert": "2.0.0",
        "phpunit/phpunit": "9.6.36",
        "povils/phpmnd": "3.6.2",
        "rector/rector": "2.0.10",
        "seld/jsonlint": "1.11.0",
        "squizlabs/php_codesniffer": "3.13.6",
        "sylius-labs/coding-standard": "4.4.0",
        "sylius/test-application": "^2.2@alpha",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/lock": "^7.4 || ^8.0"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Synolia\\SyliusMailTesterPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Synolia\\SyliusMailTesterPlugin\\": "tests/",
            "Tests\\Synolia\\SyliusMailTesterPlugin\\TestApplication\\": "tests/TestApplication/src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "phpro/grumphp": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/thanks": true
        }
    },
    "scripts": {
        "ecs": "ecs check -c ruleset/ecs.php --ansi --clear-cache",
        "fix-ecs": "@ecs --fix",
        "phpmd": "phpmd src ansi ruleset/.php_md.xml",
        "phpstan": "phpstan analyse src -c ruleset/phpstan.neon",
        "phpunit": "phpunit tests/PHPUnit --colors=always",
        "tests": [
            "@ecs",
            "@phpmd",
            "@phpstan",
            "@phpunit"
        ],
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "php bin/create_node_symlink.php"
        ]
    },
    "extra": {
        "public-dir": "vendor/sylius/test-application/public"
    }
}
